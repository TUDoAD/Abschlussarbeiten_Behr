afo:hasMolarFlowCarbonMonoxide a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowCarbonMonoxide"@en ;
    rdfs:comment "Molar flow of carbon monoxide (CO) in the mixture"@en ;
