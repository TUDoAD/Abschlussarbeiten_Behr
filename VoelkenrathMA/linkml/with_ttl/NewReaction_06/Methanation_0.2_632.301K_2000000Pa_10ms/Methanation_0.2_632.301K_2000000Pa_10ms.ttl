afo:hasTurnoverCarbonDioxide a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasTurnover .

afo:hasTurnoverHydrogen a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasTurnover .

afo:hasUnnormalizedSelectivity_CO2_CH4 a owl:DatatypeProperty ;
    rdfs:label "hasUnnormalizedSelectivity_CO2_CH4"@en ;
    rdfs:comment "Selectivity of CO2 towards CH4, not normalized (YAML: Selectivity)"@en ;
