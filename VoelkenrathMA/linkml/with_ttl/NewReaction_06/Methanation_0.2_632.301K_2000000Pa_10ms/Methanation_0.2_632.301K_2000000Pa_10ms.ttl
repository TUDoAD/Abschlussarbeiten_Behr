afo:hasCatalystLoading a owl:DatatypeProperty ;
    rdfs:label "hasCatalystLoading"@en ;
    rdfs:comment "Loading of the catalyst in the reactor"@en ;
    rdfs:range xsd:decimal .

afo:hasCatalystParticleDiameter a owl:DatatypeProperty ;
    rdfs:label "hasCatalystParticleDiameter"@en ;
    rdfs:comment "Diameter of the catalyst particles"@en ;
    rdfs:range xsd:decimal .

afo:hasCatalystVoidFraction a owl:DatatypeProperty ;
    rdfs:label "hasCatalystVoidFraction"@en ;
    rdfs:comment "Void fraction in the catalyst bed"@en ;
    rdfs:range xsd:decimal .

afo:hasKineticParameterBr a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterBr"@en ;
    rdfs:comment "Kinetic parameter br of the rate expression"@en ;
    rdfs:range xsd:decimal .

afo:hasKineticParameterK1 a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterK1"@en ;
    rdfs:comment "Kinetic parameter K_1 of the rate expression (NewReaction-Datasheets: K_CO2)"@en ;
    rdfs:range xsd:decimal .

afo:hasKineticParameterK2 a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterK2"@en ;
    rdfs:comment "Kinetic parameter K_2 of the rate expression (NewReaction-Datasheets: K_H2)"@en ;
    rdfs:range xsd:decimal .

afo:hasKineticParameterK3 a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterK3"@en ;
    rdfs:comment "Kinetic parameter K_3 of the rate expression (NewReaction-Datasheets: K_H2O)"@en ;
    rdfs:range xsd:decimal .

afo:hasMolarFlowCarbonDioxide a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowCarbonDioxide"@en ;
    rdfs:comment "Molar flow of carbon dioxide (CO2) in the mixture"@en ;
