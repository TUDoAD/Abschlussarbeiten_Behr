afo:hasReactionId a owl:DatatypeProperty ;
    rdfs:label "hasReactionId"@en ;
    rdfs:comment "Identifier of the reaction within the mechanism (YAML: id)"@en ;
    rdfs:range xsd:integer .

afo:hasReactionMechanism a owl:ObjectProperty ;
    rdfs:label "hasReactionMechanism"@en ;
    rdfs:comment "Reaction mechanism used in the simulation (YAML: ChemicalReaction)"@en .

afo:hasReactionStep a owl:ObjectProperty ;
    rdfs:label "hasReactionStep"@en ;
    rdfs:comment "Reaction (step) of the mechanism"@en .

afo:hasReactiveVolume a owl:DatatypeProperty ;
    rdfs:label "hasReactiveVolume"@en ;
    rdfs:comment "Volume of the reactive space in the reactor"@en ;
    rdfs:range xsd:decimal .

afo:hasReactor a owl:ObjectProperty ;
    rdfs:label "hasReactor"@en ;
    rdfs:comment "The simulated reactor (YAML: Reactor)"@en .

afo:hasReactorCalculationMode a owl:DatatypeProperty ;
    rdfs:label "hasReactorCalculationMode"@en ;
    rdfs:comment "Calculation mode for the reactor (e.g. isothermal)"@en ;
    rdfs:range xsd:string .

afo:hasReactorNumberOfTubes a owl:DatatypeProperty ;
    rdfs:label "hasReactorNumberOfTubes"@en ;
    rdfs:comment "Number of tubes in the reactor"@en ;
    rdfs:range xsd:integer .

afo:hasReactorTubeDiameter a owl:DatatypeProperty ;
    rdfs:label "hasReactorTubeDiameter"@en ;
    rdfs:comment "Diameter of the reactor tube"@en ;
    rdfs:range xsd:decimal .

afo:hasReactorTubeLength a owl:DatatypeProperty ;
    rdfs:label "hasReactorTubeLength"@en ;
    rdfs:comment "Length of the reactor tube"@en ;
    rdfs:range xsd:decimal .

afo:hasSelectivity_CO2_CH4 a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasSelectivity .

afo:hasSelectivity_CO2_CO a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasSelectivity .

afo:hasSeparatorGasOutlet a owl:ObjectProperty ;
    rdfs:label "hasSeparatorGasOutlet"@en ;
    rdfs:comment "Gas outlet of the downstream separator (YAML: Sep_Gas Composition)"@en .

afo:hasSeparatorLiquidOutlet a owl:ObjectProperty ;
    rdfs:label "hasSeparatorLiquidOutlet"@en ;
