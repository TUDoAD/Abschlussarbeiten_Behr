afo:hasMolarFlowNickel a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowNickel"@en ;
    rdfs:comment "Molar flow of nickel (Ni) in the mixture"@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf afo:hasMolarFlow .

afo:hasMolarFlowWater a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowWater"@en ;
    rdfs:comment "Molar flow of water (H2O) in the mixture"@en ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf afo:hasMolarFlow .

afo:hasMolarFractionCarbonDioxide a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasMolarFraction .

afo:hasMolarFractionCarbonMonoxide a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasMolarFraction .

afo:hasMolarFractionHydrogen a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasMolarFraction .

afo:hasMolarFractionMethane a owl:DatatypeProperty ;
