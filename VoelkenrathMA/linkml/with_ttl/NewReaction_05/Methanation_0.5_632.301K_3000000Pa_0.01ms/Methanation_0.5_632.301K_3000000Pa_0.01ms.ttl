afo:hasKineticParameterK2 a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterK2"@en ;
    rdfs:comment "Kinetic parameter K_2 of the rate expression (NewReaction-Datasheets: K_H2)"@en ;
    rdfs:range xsd:decimal .

afo:hasKineticParameterK3 a owl:DatatypeProperty ;
    rdfs:label "hasKineticParameterK3"@en ;
    rdfs:comment "Kinetic parameter K_3 of the rate expression (NewReaction-Datasheets: K_H2O)"@en ;
    rdfs:range xsd:decimal .

afo:hasMolarFlowCarbonDioxide a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowCarbonDioxide"@en ;
    rdfs:comment "Molar flow of carbon dioxide (CO2) in the mixture"@en ;
