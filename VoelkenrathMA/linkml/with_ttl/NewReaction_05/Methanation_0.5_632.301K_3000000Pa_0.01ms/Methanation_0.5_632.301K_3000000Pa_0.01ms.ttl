afo:hasMolarFlowMethane a owl:DatatypeProperty ;
    rdfs:label "hasMolarFlowMethane"@en ;
    rdfs:comment "Molar flow of methane (CH4) in the mixture"@en ;
    rdfs:range xsd:decimal ;
