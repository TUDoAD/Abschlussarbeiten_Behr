afo:hasUnnormalizedSelectivity_CO2_CO a owl:DatatypeProperty ;
    rdfs:label "hasUnnormalizedSelectivity_CO2_CO"@en ;
    rdfs:comment "Selectivity of CO2 towards CO, not normalized (YAML: Selectivity)"@en ;
    rdfs:range xsd:decimal .

afo:hasYieldMethane a owl:DatatypeProperty ;
    rdfs:subPropertyOf afo:hasYield .

reac4cat:hasComponent a owl:ObjectProperty .

reac4cat:hasInitialMixture a owl:ObjectProperty .

reac4cat:hasProduct a owl:ObjectProperty .

